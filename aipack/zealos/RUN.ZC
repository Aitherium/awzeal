// RUN.ZC -- boot-time proof: load the kernel AI layer, the engine and the model,
// answer two chat turns, then one agent request through InferQueue. Reports on COM1.
// Runs from the AI pack drive (the autostart Cd()s there).
#include "AIKERNEL.ZC"
#include "AILLM.ZC"
#include "AIINFER.ZC"
#include "AITOOLS.ZC"

U0 ZlRunProof()
{
	ZlSerInit;
	ZlLog("[AIKERNEL] compiled: FluxIDT + CapEngine + InferQueue + AgentForge\n");
	if (AILLMLoad("ENGINE.BIN", "QWEN3.BIN"))
	{
		AIAsk("What is the capital of France? Answer in one sentence.");
		AIAsk("And what is the capital of Germany?");
		if (AIInferInit >= 0 && AIInferProof(1))
			ZlLog("[AIINFER] PASS\n");
		else
			ZlLog("[AIINFER] FAIL\n");
		if (AIAgentProof)
			ZlLog("[AIAGENT] PASS\n");
		else
			ZlLog("[AIAGENT] FAIL\n");
		AIToolsInit;
		if (AIToolAsk("What is the date and time right now?") +
			AIToolAsk("Which files are on drive C:/ ?") > 0)
			ZlLog("[AITOOLS] PASS\n");
		else
			ZlLog("[AITOOLS] FAIL: the model made no tool call\n");
		(*ZlReset)();
	}
	ZlSerPut("ZLRUN-DONE\n");
}
ZlRunProof;
if (zl.ready)
	AISerialChat;
