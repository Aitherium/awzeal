CKernelState kernel_state;


//==== Kernel/FluxIDT.ZC ====
/*ZealOS-AI: FluxIDT ΓÇö Interrupt-Driven Event Bus
Absorbs AitherOS FluxEmitter + AitherEvents into kernel-native
ring-buffer event system using IDT vectors 0x60-0x7F.

Latency: ~0.1us (interrupt + ring write) vs AitherOS ~50us (Redis)

Each vector gets a CFluxRing (lock-free SPSC ring buffer) and
up to FLUX_MAX_HANDLERS chained handlers invoked on emit.
*/

CFluxVector		flux_vectors[FLUX_MAX_VECTORS];
CFluxContextState flux_state;

U0 FluxRingInit(CFluxRing *ring)
{//Initialize a ring buffer to empty state.
	ring->head = 0;
	ring->tail = 0;
	ring->capacity = FLUX_RING_CAPACITY;
	ring->drop_count = 0;
	ring->total_events = 0;
}

U0 FluxInit()
{//Initialize all FluxIDT vectors and rings.
	I64 i, j;

	MemSet(&flux_state, 0, sizeof(CFluxContextState));
	for (i = 0; i < FLUX_MAX_VECTORS; i++)
	{
		FluxRingInit(&flux_vectors[i].ring);
		flux_vectors[i].handler_count = 0;
		for (j = 0; j < FLUX_MAX_HANDLERS; j++)
		{
			flux_vectors[i].handlers[j].handler = NULL;
			flux_vectors[i].handlers[j].agent_id = 0;
		}
	}
	flux_state.valence = 0;
	flux_state.arousal = 0;
	flux_state.pain = 0;
}

Bool FluxEmit(I64 vector, I64 event_type, I64 source_agent,
			  U8 *payload, I64 payload_len)
{//Write event to ring buffer and invoke handlers.
//Returns FALSE if ring is full (event dropped).
	I64			 vec_idx, next_head, i;
	CFluxVector	*fv;
	CFluxRing	*ring;
	CFluxEvent	*evt;

	if (vector < I_FLUX_BASE || vector > I_FLUX_BASE + FLUX_MAX_VECTORS - 1)
		return FALSE;

	vec_idx = vector - I_FLUX_BASE;
	fv = &flux_vectors[vec_idx];
	ring = &fv->ring;

	PUSHFD
	CLI

	//Check if ring is full
	next_head = (ring->head + 1) % ring->capacity;
	if (next_head == ring->tail)
	{
		ring->drop_count++;
		POPFD
		return FALSE;
	}

	//Write event into slot
	evt = &ring->events[ring->head];
	evt->timestamp = TSCGet;
	evt->event_type = event_type;
	evt->source_agent = source_agent;

	if (payload && payload_len > 0)
	{
		if (payload_len > FLUX_PAYLOAD_SIZE)
			payload_len = FLUX_PAYLOAD_SIZE;
		MemCopy(evt->payload, payload, payload_len);
		evt->payload_len = payload_len;
	}
	else
		evt->payload_len = 0;

	//Advance head (publish)
	ring->head = next_head;
	ring->total_events++;

	//Invoke chained handlers
	for (i = 0; i < fv->handler_count; i++)
	{
		if (fv->handlers[i].handler)
		{
			//handler_agent_id==0 means subscribe to all
			if (fv->handlers[i].agent_id == 0 ||
				fv->handlers[i].agent_id == source_agent)
			{
				(*fv->handlers[i].handler)(evt);
			}
		}
	}

	POPFD
	return TRUE;
}

Bool FluxSubscribe(I64 vector, U0 (*handler_fn)(CFluxEvent *event),
				   I64 agent_id=0)
{//Register a handler for a FluxIDT vector.
//agent_id=0 means receive all events on this vector.
	I64			 vec_idx;
	CFluxVector	*fv;

	if (vector < I_FLUX_BASE || vector > I_FLUX_BASE + FLUX_MAX_VECTORS - 1)
		return FALSE;

	vec_idx = vector - I_FLUX_BASE;
	fv = &flux_vectors[vec_idx];

	if (fv->handler_count >= FLUX_MAX_HANDLERS)
		return FALSE;

	PUSHFD
	CLI
	fv->handlers[fv->handler_count].handler = handler_fn;
	fv->handlers[fv->handler_count].agent_id = agent_id;
	fv->handler_count++;
	POPFD

	return TRUE;
}

Bool FluxUnsubscribe(I64 vector, U0 (*handler_fn)(CFluxEvent *event))
{//Remove a handler from a FluxIDT vector.
	I64			 vec_idx, i, j;
	CFluxVector	*fv;

	if (vector < I_FLUX_BASE || vector > I_FLUX_BASE + FLUX_MAX_VECTORS - 1)
		return FALSE;

	vec_idx = vector - I_FLUX_BASE;
	fv = &flux_vectors[vec_idx];

	PUSHFD
	CLI
	for (i = 0; i < fv->handler_count; i++)
	{
		if (fv->handlers[i].handler == handler_fn)
		{
			//Shift remaining handlers down
			for (j = i; j < fv->handler_count - 1; j++)
				MemCopy(&fv->handlers[j], &fv->handlers[j + 1], sizeof(CFluxHandler));
			fv->handler_count--;
			fv->handlers[fv->handler_count].handler = NULL;
			POPFD
			return TRUE;
		}
	}
	POPFD
	return FALSE;
}

CFluxEvent *FluxPoll(I64 vector)
{//Read next event from ring. Returns NULL if empty.
//Caller must process before next FluxPoll on same vector.
	I64			 vec_idx;
	CFluxRing	*ring;
	CFluxEvent	*evt;

	if (vector < I_FLUX_BASE || vector > I_FLUX_BASE + FLUX_MAX_VECTORS - 1)
		return NULL;

	vec_idx = vector - I_FLUX_BASE;
	ring = &flux_vectors[vec_idx].ring;

	if (ring->tail == ring->head)
		return NULL; //empty

	evt = &ring->events[ring->tail];
	ring->tail = (ring->tail + 1) % ring->capacity;
	return evt;
}

U0 FluxSensation(F64 pain_delta, F64 pleasure_delta)
{//Update system affect state and emit PAIN_PLEASURE event.
//pain_delta > 0 increases pain, pleasure_delta > 0 improves valence.
	U8 buf[64];

	flux_state.pain += pain_delta;
	if (flux_state.pain < 0) flux_state.pain = 0;
	if (flux_state.pain > 1.0) flux_state.pain = 1.0;

	flux_state.valence += pleasure_delta - pain_delta;
	if (flux_state.valence < -1.0) flux_state.valence = -1.0;
	if (flux_state.valence > 1.0) flux_state.valence = 1.0;

	//Arousal increases with any strong sensation
	flux_state.arousal += Abs(pain_delta) + Abs(pleasure_delta);
	if (flux_state.arousal > 1.0) flux_state.arousal = 1.0;

	flux_state.last_update = TSCGet;

	//Emit event with current state
	MemCopy(buf, &flux_state, MinI64(sizeof(CFluxContextState), 64));
	FluxEmit(I_FLUX_PAIN_PLEASURE, FLUX_EVT_STATE_CHANGE, 0, buf, 64);
}

U0 FluxUpdateContext()
{//Called periodically to update context state.
	flux_state.uptime_jiffies = counts.jiffies;

	//Decay arousal over time (half-life ~60s)
	flux_state.arousal *= 0x3FEFAE147AE147AE(F64); //0.99

	flux_state.last_update = TSCGet;
}

I64 FluxRingCount(I64 vector)
{//Return number of pending events in a vector's ring.
	I64		 vec_idx;
	CFluxRing *ring;

	if (vector < I_FLUX_BASE || vector > I_FLUX_BASE + FLUX_MAX_VECTORS - 1)
		return -1;

	vec_idx = vector - I_FLUX_BASE;
	ring = &flux_vectors[vec_idx].ring;

	if (ring->head >= ring->tail)
		return ring->head - ring->tail;
	else
		return ring->capacity - ring->tail + ring->head;
}

U0 FluxDump(I64 vector)
{//Debug: print ring stats for a vector.
	I64		 vec_idx;
	CFluxRing *ring;

	if (vector < I_FLUX_BASE || vector > I_FLUX_BASE + FLUX_MAX_VECTORS - 1)
	{
		"FluxDump: invalid vector 0x%02X\n", vector;
		return;
	}

	vec_idx = vector - I_FLUX_BASE;
	ring = &flux_vectors[vec_idx].ring;
	"FluxIDT[0x%02X]: head=%d tail=%d pending=%d total=%d drops=%d handlers=%d\n",
		vector, ring->head, ring->tail,
		FluxRingCount(vector),
		ring->total_events, ring->drop_count,
		flux_vectors[vec_idx].handler_count;
}


//==== Kernel/CapEngine.ZC ====
/*ZealOS-AI: CapEngine ΓÇö Capability Security Engine
Absorbs AitherOS CapabilityEngine into kernel-native
HMAC-SHA256 capability tokens with default-deny policy.

All agent operations pass through CapCheck() before execution.
Audit log records all allow/deny decisions for forensics.
*/

CCapEngine cap_engine;

U0 CapEngineInit()
{//Initialize capability engine with empty state.
	I64 i;

	for (i = 0; i < AGENT_MAX_AGENTS; i++)
		cap_engine.tokens[i] = NULL;
	cap_engine.audit_head = 0;
	cap_engine.audit_count = 0;

	//Initialize HMAC key from RDTSC entropy
	//In production this would use a proper CSPRNG
	for (i = 0; i < CAP_HMAC_KEY_LEN; i++)
		cap_engine.hmac_key[i] = TSCGet;
}

Bool CapPatternMatch(U8 *pattern, U8 *resource)
{//Match a dot-delimited capability pattern against a resource string.
//Supports wildcard '*' at any segment level.
//  "agent.*" matches "agent.worker", "agent.monitor"
//  "tool.shell.*" matches "tool.shell.exec", "tool.shell.read"
//  "*" matches everything
	U8 *pp = pattern, *rp = resource;

	while (*pp && *rp)
	{
		if (*pp == '*')
		{
			//Wildcard: skip to next dot or end in both
			pp++;
			if (!*pp) return TRUE; //trailing * matches all
			if (*pp != '.') return FALSE; //invalid pattern
			//Skip to next dot in resource
			while (*rp && *rp != '.') rp++;
		}
		else if (*pp == *rp)
		{
			pp++;
			rp++;
		}
		else
			return FALSE;
	}

	//Both must be exhausted, or pattern ends with *
	if (!*pp && !*rp) return TRUE;
	if (*pp == '*' && !*(pp + 1)) return TRUE;
	return FALSE;
}

U0 CapAuditRecord(I64 agent_id, U8 *resource, I64 action, I64 result)
{//Record a capability check in the audit log (circular buffer).
	CCapAudit *entry;

	entry = &cap_engine.audit_log[cap_engine.audit_head];
	entry->timestamp = TSCGet;
	entry->agent_id = agent_id;
	if (resource)
		MemCopy(entry->resource, resource, MinI64(StrLen(resource) + 1, CAP_PATTERN_LEN));
	else
		entry->resource[0] = 0;
	entry->action = action;
	entry->result = result;

	cap_engine.audit_head = (cap_engine.audit_head + 1) % CAP_MAX_AUDIT_LOG;
	if (cap_engine.audit_count < CAP_MAX_AUDIT_LOG)
		cap_engine.audit_count++;
}

Bool CapCheck(I64 agent_id, U8 *resource, I64 action)
{//Check if agent has capability to perform action on resource.
//DEFAULT-DENY: returns FALSE unless explicitly granted.
	CCapToken	*token;
	I64			 i;

	if (agent_id < 0 || agent_id >= AGENT_MAX_AGENTS)
	{
		CapAuditRecord(agent_id, resource, action, CAP_AUDIT_DENY);
		return FALSE;
	}

	token = cap_engine.tokens[agent_id];
	if (!token)
	{
		CapAuditRecord(agent_id, resource, action, CAP_AUDIT_DENY);
		return FALSE;
	}

	//Check expiry
	if (token->expiry && counts.jiffies > token->expiry)
	{
		CapAuditRecord(agent_id, resource, action, CAP_AUDIT_DENY);
		return FALSE;
	}

	//Check each capability in token
	for (i = 0; i < token->cap_count; i++)
	{
		if (CapPatternMatch(token->caps[i].resource, resource))
		{
			if (token->caps[i].action_mask & action)
			{
				CapAuditRecord(agent_id, resource, action, CAP_AUDIT_ALLOW);
				return TRUE;
			}
		}
	}

	//Default deny
	CapAuditRecord(agent_id, resource, action, CAP_AUDIT_DENY);
	return FALSE;
}

CCapToken *CapTokenCreate(I64 agent_id)
{//Create a new empty capability token for an agent.
	CCapToken *token;

	if (agent_id < 0 || agent_id >= AGENT_MAX_AGENTS)
		return NULL;

	token = CAlloc(sizeof(CCapToken));
	token->agent_id = agent_id;
	token->cap_count = 0;
	token->llm_tier_max = 10; //unrestricted by default
	token->expiry = 0; //never expires by default

	PUSHFD
	CLI
	cap_engine.tokens[agent_id] = token;
	POPFD

	return token;
}

Bool CapTokenGrant(CCapToken *token, U8 *resource, I64 action_mask)
{//Add a capability grant to an existing token.
	if (!token || token->cap_count >= CAP_MAX_CAPABILITIES)
		return FALSE;

	MemCopy(token->caps[token->cap_count].resource, resource,
			MinI64(StrLen(resource) + 1, CAP_PATTERN_LEN));
	token->caps[token->cap_count].action_mask = action_mask;
	token->caps[token->cap_count].constraints = 0;
	token->cap_count++;

	return TRUE;
}

CCapToken *CapTokenNarrow(CCapToken *parent, I64 new_agent_id)
{//Create a narrowed copy of a parent token for a child agent.
//The child can never have more capabilities than the parent.
	CCapToken *child;
	I64 i;

	if (!parent) return NULL;

	child = CapTokenCreate(new_agent_id);
	if (!child) return NULL;

	for (i = 0; i < parent->cap_count; i++)
	{
		MemCopy(&child->caps[i], &parent->caps[i], sizeof(CCapability));
	}
	child->cap_count = parent->cap_count;
	child->llm_tier_max = parent->llm_tier_max;

	return child;
}

U0 CapTokenRevoke(I64 agent_id)
{//Revoke all capabilities for an agent.
	if (agent_id < 0 || agent_id >= AGENT_MAX_AGENTS)
		return;

	PUSHFD
	CLI
	if (cap_engine.tokens[agent_id])
	{
		Free(cap_engine.tokens[agent_id]);
		cap_engine.tokens[agent_id] = NULL;
	}
	POPFD
}

U0 CapAuditDump(I64 count=10)
{//Debug: print last N audit log entries.
	I64 i, idx;
	U8 *audit_res_st;

	if (count > cap_engine.audit_count)
		count = cap_engine.audit_count;

	"=== Capability Audit Log (last %d entries) ===\n", count;
	for (i = 0; i < count; i++)
	{
		idx = (cap_engine.audit_head - count + i + CAP_MAX_AUDIT_LOG) % CAP_MAX_AUDIT_LOG;
		if (cap_engine.audit_log[idx].result == CAP_AUDIT_ALLOW)
			audit_res_st = "ALLOW";
		else
			audit_res_st = "DENY";
		"  agent=%d resource='%s' action=0x%02X result=%s\n",
			cap_engine.audit_log[idx].agent_id,
			cap_engine.audit_log[idx].resource,
			cap_engine.audit_log[idx].action,
			audit_res_st;
	}
}


//==== Kernel/InferQueue.ZC ====
/*ZealOS-AI: InferQueue ΓÇö Unified Inference Priority Queue
Absorbs AitherOS LLMQueue + ModelRegistry into a kernel-native
priority queue with backend routing.

ALL inference requests go through this queue regardless of backend:
  - EXTERN_HTTP: POST to remote vLLM/Claude/Ollama (Phase 1)
  - LOCAL_CPU:   llama.cpp on host CPU (Phase 2)
  - LOCAL_GPU:   Xe/AMDGPU compute kernel (Phase 3)

The queue provides:
  - Priority ordering (effort-based, kernel-priority bypass)
  - Request deduplication (same prompt ΓåÆ share result)
  - Per-agent rate limiting (RPM budgets)
  - Backend routing (modelΓåÆbackend, auto-selection)
  - Latency tracking and stats

Equivalent to AitherOS MicroScheduler:8150 but at syscall speed.
*/

CInferQueue infer_queue;
//Local CPU engine hook: set by /AIPack AILLM when an engine is loaded.
//Fills InferResp(req) and returns TRUE on success.
Bool (*infer_local_cpu_fp)(CInferReq *req, CInferResp *resp) = NULL;

CInferResp *InferResp(CInferReq *req)
{//Response slot paired with a request.
	return &infer_queue.responses[(req(U8 *) - infer_queue.requests(U8 *)) / sizeof(CInferReq)];
}

U0 InferQueueInit()
{//Initialize the inference queue to empty state.
	I64 i;

	MemSet(&infer_queue, 0, sizeof(CInferQueue));
	infer_queue.next_id = 1;
	infer_queue.agent_rpm_limit = 60;
	infer_queue.agent_last_reset = counts.jiffies;

	for (i = 0; i < INFER_QUEUE_CAPACITY; i++)
		infer_queue.requests[i].status = INFER_STATUS_FREE;

	StrCopy(infer_queue.default_model, "auto");
}

//--- Model Registry ---

I64 ModelRegister(U8 *name, I64 backend, I64 vram_mb, I64 ctx_len,
				  F64 speed, I64 quality, U8 *endpoint=NULL)
{//Register a model in the registry. Returns model index or -1.
	CModelEntry *m;

	if (infer_queue.model_count >= INFER_MODEL_MAX)
		return -1;
	if (!name || !*name)
		return -1;

	m = &infer_queue.models[infer_queue.model_count];
	MemCopy(m->name, name, MinI64(StrLen(name) + 1, INFER_MODEL_NAME_LEN));
	m->backend = backend;
	m->vram_mb = vram_mb;
	m->ctx_len = ctx_len;
	m->speed = speed;
	m->quality = quality;
	m->loaded = FALSE;
	m->available = (backend == INFER_BACKEND_EXTERN); //extern is always "available"
	m->total_requests = 0;
	m->total_tokens = 0;
	m->total_errors = 0;

	if (endpoint)
		MemCopy(m->endpoint, endpoint, MinI64(StrLen(endpoint) + 1, INFER_ENDPOINT_LEN));
	else
		m->endpoint[0] = 0;

	return infer_queue.model_count++;
}

CModelEntry *ModelFind(U8 *name)
{//Find a model by name. Returns NULL if not found.
	I64 i;

	for (i = 0; i < infer_queue.model_count; i++)
	{
		if (!StrCompare(infer_queue.models[i].name, name))
			return &infer_queue.models[i];
	}
	return NULL;
}

CModelEntry *ModelAutoSelect(I64 effort, I64 agent_id)
{//Auto-select best model based on effort level and availability.
//Mirrors AitherOS EffortScaler: low effort ΓåÆ small/fast, high ΓåÆ quality.
	I64			 i, best_idx;
	F64			 best_score, score;
	CModelEntry	*m;
	CCapToken	*token;

	best_idx = -1;
	best_score = -1.0;

	//Check agent's LLM tier cap from capability token
	token = cap_engine.tokens[agent_id];
	if (token && effort > token->llm_tier_max)
		effort = token->llm_tier_max;

	for (i = 0; i < infer_queue.model_count; i++)
	{
		m = &infer_queue.models[i];
		if (!m->available)
			goto ms_next;

		//Score: balance quality against speed based on effort
		//High effort ΓåÆ weight quality. Low effort ΓåÆ weight speed.
		if (effort >= 7)
			score = ToF64(m->quality) * 2.0 + m->speed * 0.5;
		else if (effort >= 3)
			score = ToF64(m->quality) * 1.0 + m->speed * 1.0;
		else
			score = ToF64(m->quality) * 0.5 + m->speed * 2.0;

		//Penalize GPU models if no GPU available
		if (m->backend == INFER_BACKEND_LOCAL_GPU && m->vram_mb > 0)
			score *= 0.1; //Phase 0/1: basically skip GPU models

		if (score > best_score)
		{
			best_score = score;
			best_idx = i;
		}
ms_next:
		best_score = best_score;
	}

	if (best_idx >= 0)
		return &infer_queue.models[best_idx];
	return NULL;
}

//--- Request Submission ---

I64 InferHashPrompt(U8 *prompt, I64 len)
{//Simple hash for dedup. Uses ZealOS HashStr on first 256 chars.
	U8 buf[257];
	I64 copy_len;

	copy_len = MinI64(len, 256);
	MemCopy(buf, prompt, copy_len);
	buf[copy_len] = 0;
	return HashStr(buf);
}

I64 InferFindDedup(I64 dedup_hash)
{//Find an existing queued/running request with same hash.
//Returns request index or -1.
	I64 i;

	if (!dedup_hash) return -1;

	for (i = 0; i < INFER_QUEUE_CAPACITY; i++)
	{
		if ((infer_queue.requests[i].status == INFER_STATUS_QUEUED ||
			 infer_queue.requests[i].status == INFER_STATUS_RUNNING) &&
			infer_queue.requests[i].dedup_hash == dedup_hash)
			return i;
	}
	return -1;
}

I64 InferFindFreeSlot()
{//Find a free request slot. Returns index or -1.
	I64 i;

	for (i = 0; i < INFER_QUEUE_CAPACITY; i++)
	{
		if (infer_queue.requests[i].status == INFER_STATUS_FREE ||
			infer_queue.requests[i].status == INFER_STATUS_COMPLETE ||
			infer_queue.requests[i].status == INFER_STATUS_FAILED ||
			infer_queue.requests[i].status == INFER_STATUS_DEDUPED)
			return i;
	}
	return -1;
}

CInferReq *InferSubmit(I64 agent_id, U8 *prompt, I64 prompt_len,
					   U8 *model_name=NULL, I64 priority=5,
					   I64 max_tokens=512, I64 temperature_x100=70,
					   U0 (*callback)(CInferReq *req)=NULL)
{//Submit an inference request to the queue.
//Returns request pointer, or NULL if queue full / rate limited.
	CInferReq	*req;
	I64			 slot, dedup_idx, dedup_hash;

	//Capability check
	if (!CapCheck(agent_id, "infer.*", CAPa_EXECUTE))
	{
		FluxEmit(I_FLUX_SECURITY, FLUX_EVT_WARNING, agent_id,
				 "INFER_DENIED", 12);
		return NULL;
	}

	//Rate limit check (reset counters every ~60s)
	if (counts.jiffies - infer_queue.agent_last_reset > 60 * 18) //~18.2 Hz PIT
	{
		MemSet(infer_queue.agent_rpm, 0, sizeof(I64) * AGENT_MAX_AGENTS);
		infer_queue.agent_last_reset = counts.jiffies;
	}

	if (agent_id >= 0 && agent_id < AGENT_MAX_AGENTS)
	{
		if (infer_queue.agent_rpm[agent_id] >= infer_queue.agent_rpm_limit)
		{
			FluxEmit(I_FLUX_LLM_EVENT, FLUX_EVT_WARNING, agent_id,
					 "RATE_LIMITED", 12);
			return NULL;
		}
		infer_queue.agent_rpm[agent_id]++;
	}

	//Dedup check
	dedup_hash = InferHashPrompt(prompt, prompt_len);
	dedup_idx = InferFindDedup(dedup_hash);
	if (dedup_idx >= 0)
	{
		infer_queue.stats.total_deduped++;
		//Return the existing request (caller can poll or attach callback)
		return &infer_queue.requests[dedup_idx];
	}

	//Find free slot
	PUSHFD
	CLI
	slot = InferFindFreeSlot();
	if (slot < 0)
	{
		POPFD
		infer_queue.stats.total_failed++;
		return NULL; //queue full
	}

	req = &infer_queue.requests[slot];
	req->id = infer_queue.next_id++;
	req->priority = priority;
	req->agent_id = agent_id;
	req->max_tokens = max_tokens;
	req->temperature_x100 = temperature_x100;
	req->dedup_hash = dedup_hash;
	req->status = INFER_STATUS_QUEUED;
	req->flags = 0;
	req->submit_tsc = TSCGet;
	req->start_tsc = 0;
	req->complete_tsc = 0;
	req->callback = callback;

	//Copy model name
	if (model_name && *model_name)
		MemCopy(req->model, model_name, MinI64(StrLen(model_name) + 1, INFER_MODEL_NAME_LEN));
	else
		StrCopy(req->model, "auto");

	//Copy prompt (truncate if too long)
	if (prompt_len > INFER_PROMPT_INLINE)
		prompt_len = INFER_PROMPT_INLINE;
	MemCopy(req->prompt, prompt, prompt_len);
	req->prompt_len = prompt_len;

	infer_queue.count++;
	infer_queue.stats.total_submitted++;
	if (infer_queue.count > infer_queue.stats.peak_depth)
		infer_queue.stats.peak_depth = infer_queue.count;

	POPFD

	FluxEmit(I_FLUX_LLM_EVENT, FLUX_EVT_REQUEST, agent_id,
			 req->model, StrLen(req->model));

	return req;
}

//--- Dispatch Engine ---

CInferReq *InferPickNext()
{//Select highest-priority queued request for dispatch.
//System-priority requests bypass the queue.
	I64			 i, best_idx;
	I64			 best_priority;
	CInferReq	*req;

	best_idx = -1;
	best_priority = -1;

	for (i = 0; i < INFER_QUEUE_CAPACITY; i++)
	{
		req = &infer_queue.requests[i];
		if (req->status != INFER_STATUS_QUEUED)
			goto pn_next;

		//System priority always wins
		if (Bt(&req->flags, INFERf_SYSTEM_PRIORITY))
			return req;

		if (req->priority > best_priority)
		{
			best_priority = req->priority;
			best_idx = i;
		}
pn_next:
		best_priority = best_priority;
	}

	if (best_idx >= 0)
		return &infer_queue.requests[best_idx];
	return NULL;
}

U0 InferDispatch()
{//Dispatch next queued request to appropriate backend.
//Called periodically or when new requests arrive.
	CInferReq	*req;
	CModelEntry	*model;
	I64			 latency;

	req = InferPickNext;
	if (!req) return;

	//Resolve model
	if (!StrCompare(req->model, "auto"))
		model = ModelAutoSelect(req->priority, req->agent_id);
	else
		model = ModelFind(req->model);

	if (!model || !model->available)
	{
		req->status = INFER_STATUS_FAILED;
		infer_queue.count--;
		infer_queue.stats.total_failed++;
		FluxEmit(I_FLUX_LLM_EVENT, FLUX_EVT_ERROR, req->agent_id,
				 "NO_MODEL", 8);
		if (req->callback)
			(*req->callback)(req);
		return;
	}

	req->status = INFER_STATUS_RUNNING;
	req->start_tsc = TSCGet;

	//Dispatch to backend
	switch (model->backend)
	{
		case INFER_BACKEND_EXTERN:
			//Phase 1: HTTP POST to model->endpoint
			//For now, stub ΓÇö mark as failed with message
			req->status = INFER_STATUS_FAILED;
			infer_queue.count--;
			infer_queue.stats.total_failed++;
			model->total_errors++;
			FluxEmit(I_FLUX_LLM_EVENT, FLUX_EVT_ERROR, req->agent_id,
					 "NO_NETWORK", 10);
			break;

		case INFER_BACKEND_LOCAL_CPU:
			//Phase 2: ring-0 engine (aipack AILLM) through infer_local_cpu_fp
			if (infer_local_cpu_fp && (*infer_local_cpu_fp)(req, InferResp(req)))
			{
				req->status = INFER_STATUS_COMPLETE;
				break;
			}
			req->status = INFER_STATUS_FAILED;
			infer_queue.count--;
			infer_queue.stats.total_failed++;
			FluxEmit(I_FLUX_LLM_EVENT, FLUX_EVT_ERROR, req->agent_id,
					 "NO_CPU_INFER", 12);
			break;

		case INFER_BACKEND_LOCAL_GPU:
			//Phase 3: GPU compute dispatch
			req->status = INFER_STATUS_FAILED;
			infer_queue.count--;
			infer_queue.stats.total_failed++;
			FluxEmit(I_FLUX_LLM_EVENT, FLUX_EVT_ERROR, req->agent_id,
					 "NO_GPU", 6);
			break;

		default:
			req->status = INFER_STATUS_FAILED;
			infer_queue.count--;
			infer_queue.stats.total_failed++;
			break;
	}

	//If completed (future backends), invoke callback
	if (req->status == INFER_STATUS_COMPLETE)
	{
		req->complete_tsc = TSCGet;
		infer_queue.count--;
		infer_queue.stats.total_completed++;
		model->total_requests++;

		//Update running average latency
		latency = req->complete_tsc - req->start_tsc;
		if (infer_queue.stats.avg_latency_tsc == 0)
			infer_queue.stats.avg_latency_tsc = latency;
		else
			infer_queue.stats.avg_latency_tsc =
				(infer_queue.stats.avg_latency_tsc * 7 + latency) / 8; //EMA

		FluxEmit(I_FLUX_LLM_EVENT, FLUX_EVT_RESPONSE, req->agent_id,
				 model->name, StrLen(model->name));

		if (req->callback)
			(*req->callback)(req);
	}
}

//--- Convenience: Synchronous Inference ---

CInferReq *InferSync(I64 agent_id, U8 *prompt, I64 prompt_len,
					 U8 *model_name=NULL, I64 max_tokens=512)
{//Submit and wait for inference to complete. Yields while waiting.
//Returns completed request or NULL on failure.
	CInferReq *req;

	req = InferSubmit(agent_id, prompt, prompt_len, model_name, 5,
					  max_tokens, 70, NULL);
	if (!req) return NULL;

	//Dispatch immediately
	InferDispatch;

	//Wait for completion (cooperative yield)
	while (req->status == INFER_STATUS_QUEUED ||
		   req->status == INFER_STATUS_RUNNING)
	{
		Yield;
		InferDispatch; //keep dispatching
	}

	return req;
}

//--- GPU State ---

CGPUState gpu_state;

U0 GPUInit()
{//Initialize GPU state. Phase 0: no GPUs.
	MemSet(&gpu_state, 0, sizeof(CGPUState));
}

I64 GPUDetect()
{//Scan PCI bus for known GPU devices.
//Phase 3: populate gpu_state.devices[] from PCI enumeration.
